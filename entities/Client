{
  "name": "Client",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "الاسم الكامل"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "فرد",
        "شركة",
        "مؤسسة",
        "جهة حكومية",
        "ورثة"
      ],
      "default": "فرد"
    },
    "id_number": {
      "type": "string",
      "description": "رقم الهوية / السجل التجاري"
    },
    "phone": {
      "type": "string",
      "description": "رقم الهاتف"
    },
    "email": {
      "type": "string",
      "description": "البريد الإلكتروني"
    },
    "address": {
      "type": "string",
      "description": "العنوان"
    },
    "nationality": {
      "type": "string",
      "description": "الجنسية"
    },
    "notes": {
      "type": "string",
      "description": "ملاحظات"
    },
    "status": {
      "type": "string",
      "enum": [
        "نشط",
        "غير نشط",
        "مهمل"
      ],
      "default": "نشط"
    },
    "client_role": {
      "type": "string",
      "default": "موكل",
      "description": "الصفة القانونية الشاملة للموكل أو الشخص المرتبط بالملف"
    },
    "name_ar": {
      "type": "string",
      "description": "الاسم العربي المعتمد للعرض والبحث"
    },
    "name_en": {
      "type": "string",
      "description": "الاسم الإنجليزي / اللاتيني للبحث والمطابقة"
    },
    "name_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "أسماء بديلة وتهجئات أخرى للموكل"
    }
  },
  "required": [
    "full_name",
    "phone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "role": "user"
          }
        ]
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
