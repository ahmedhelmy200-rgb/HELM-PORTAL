VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_STORAGE_BUCKET=uploads

# Production site origin, for email/password reset links and desktop fallback.
# Example: https://your-domain.example
VITE_PUBLIC_SITE_URL=

# Google OAuth now uses the current browser origin automatically.
# Keep this empty unless you deliberately need a fallback origin.
VITE_SUPABASE_GOOGLE_REDIRECT_URL=

VITE_OCR_EDGE_FUNCTION=extract-ocr
VITE_APP_NAME=HELM
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API key for embedded HELM Smart AI assistant
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
