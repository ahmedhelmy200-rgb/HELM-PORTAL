{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HELM Legal Office",
  "version": "0.1.0",
  "identifier": "ae.helm.legaloffice",
  "build": {
    "beforeDevCommand": "npm run dev -- --mode desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -- --mode desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HELM Legal Office",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Business",
    "shortDescription": "نظام إدارة المكتب القانوني من HELM",
    "longDescription": "برنامج مكتبي لإدارة الموكلين والقضايا والجلسات والمستندات والحسابات، مع تخزين محلي SQLite ومزامنة سحابية.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
